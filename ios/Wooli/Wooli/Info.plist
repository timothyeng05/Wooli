<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.timothyeng.wooli</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wooli</string>
			</array>
		</dict>
	</array>
	<key>CKSharingSupported</key>
	<true/>
	<key>GooglePlacesAPIKey</key>
	<string>$(GOOGLE_PLACES_API_KEY)</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Wooli reads your cycle and symptoms from Apple Health to show your calendar and predict your next period. This stays on your iPhone.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Wooli saves the periods and symptoms you log to Apple Health, so they stay in one place.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wooli uses your location to show Eats places near you. It stays on your iPhone.</string>
	<key>TMDBAPIKey</key>
	<string>$(TMDB_API_KEY)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
